// Perimortem Engine
// Copyright © Matt Kaes
dialect : Library;

import Graphics : Package = Perimortem::Graphics;

private Default2D : Alias = Graphics::Shaders::Default2D;

@extern(.abi = "c")
private Perimortem : foreign {
  external private func run_sprite_fade_scene[
    .scene : SceneConfig,
    .top_icon : Graphics::Sprite,
    .bottom_icon : Graphics::Sprite,
  ] -> [];
}

private SceneConfig : struct {
  private title : View[Bytes];
  private window_size : Bits_32;
  private fade_in_seconds : Real_64;
  private hold_seconds : Real_64;
  private fade_out_seconds : Real_64;
}

public func main[] -> [] {
  const scene : SceneConfig = (
    .title = "Perimortem",
    .window_size = 700,
    .fade_in_seconds = 1.0,
    .hold_seconds = 1.5,
    .fade_out_seconds = 1.0,
  );

  state top_icon : Graphics::Sprite;
  top_icon.image = ".data/icon.png";
  top_icon.size_pixels = (.width = 250, .height = 250);
  top_icon.position_x = 0.0;
  top_icon.position_y = 0.45;
  top_icon.renderer = Default2D;

  state bottom_icon : Graphics::Sprite;
  bottom_icon.image = ".data/icon.png";
  bottom_icon.size_pixels = (.width = 250, .height = 250);
  bottom_icon.position_x = 0.0;
  bottom_icon.position_y = -0.45;
  bottom_icon.renderer = Default2D;

  Perimortem -> run_sprite_fade_scene(scene, top_icon, bottom_icon);
}
