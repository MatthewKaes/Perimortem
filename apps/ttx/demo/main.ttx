dialect : App;

import Runtime : Package = Perimortem.Runtime;
import SplashScreen : Scene = "splash_screen.ttx";

public func main[] -> [] {
  // Create a window for the thread so we can render scene objects.
  const window : Runtime::Window = Runtime::Window -> create(
    .title = "Perimortem",
    .width = 750,
    .height = 750,
  );

  // Set the initial scene and run it until scene is set to Void.
  Runtime -> start(
    .initial_scene = SplashScreen(),
    .window = window,
  );
}
