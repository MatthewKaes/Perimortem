dialect : App;

// Selects the App owned startup profile used to produce the final process.
// The profile chooses linked support libraries, generated platform entry code,
// and package configuration. It is not a resolved Runtime Package.
//
// Options include:
//   1. `Windowed`: Native window startup with System::Window and Vulkan support.
//   2. `Terminal`: Native terminal startup with standard input and output.
//   3. `Headless`: Background startup without a presentation surface.
runtime = Terminal {
  .title = "Scene Lifetime",
  .icon = $[resources/icon.png],
}

// Program lifecycle just wraps a callable static entry point. 
// The declaration may have any authored name but it must take no arguments and have
// a return type of `Void`.
//
// The selected lifecycle determines how the generated platform entry controls
// execution around that Callable. Unlike other languages command line arguments are
// not passed but instead can be fetched from anywhere.
//
// This program defines no arguments so they aren't provided. Later TTX might introduce
// a schmea as part of the Program lifecycle for defining command line args.
lifecycle = Program {
  start Main -> run,
}
