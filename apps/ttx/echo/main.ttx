// Perimortem Engine
// Copyright © Matt Kaes
//
// Reads complete terminal lines and writes each ordinary line back with a
// stable prefix.
//
dialect : Library;

public run : func = [] -> [] {
  const prefix : View[Unsigned_8] = "Echo: " -> get_view();
  const quit   : View[Unsigned_8] = "quit" -> get_view();
  const exit   : View[Unsigned_8] = "exit" -> get_view();
  while (true) {
    const line := System::Terminal -> read_line();
    if (line.failed or !line.available) : return;
    if (line.value == quit or line.value == exit) : return;

    const written := System::Terminal -> write_line(prefix, line.value);
    if (!written) : return;
  }
}
