/// Tetrodotoxin
/// Copyright (c) 2023-present Matt Kaes and contributors
//
// Gives the application graph one public Package name.
dialect : Package;

// Names the source frontends required to reconstruct this package without
// choosing which installed SDK artifacts provide them.
requires(
  .dialects = [
    package(.name = "Tetrodotoxin.App", .version = "1.0")::Dialect,
    package(.name = "Tetrodotoxin.Library", .version = "1.0")::Dialect,
  ],
);

package(.name = "Perimortem.Echo", .version = "1.0");
public App : alias = source("app.ttx");
