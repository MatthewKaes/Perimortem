//
// Window and Scene stack policy for the Scene Lifetime application.
dialect : App;

// Opens the native presentation used by the Scene stack.
runtime = Windowed {
  .title = "Scene Lifetime",
  .icon = $[resources/icon.png],
  .width = 800,
  .height = 600,
  .resizable = true,
}

// The first matching Signal mapping chooses the one transition applied after
// the frame has been presented.
lifecycle = Scene {
  initial Scenes::Splash;
  on Scenes::Splash.finished replace Scenes::Title;
  on Scenes::Title.shift_pressed replace Scenes::Splash;
  on Scenes::Title.space_pressed exit;
}
