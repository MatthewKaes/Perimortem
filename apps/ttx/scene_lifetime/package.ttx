// Establishes a full enviornment from a collection of various Source files.
// Resolved symbols are pushed to all loaded sources as part of the enviornment.
dialect : Package;

resolve Math : Perimortem.Math = "1.0";
resolve Graphics : Perimortem.Graphics = "1.0";
resolve Runtime : Perimortem.Runtime = "1.0";

source "scenes/splash.ttx";
source "scenes/title.ttx";
source "main.ttx";
