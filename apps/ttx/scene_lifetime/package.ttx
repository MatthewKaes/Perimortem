dialect : Package;

resolve Math : Perimortem.Math = "1.0";
resolve Graphics : Perimortem.Graphics = "1.0";
resolve Runtime : Perimortem.Runtime = "1.0";

source "scenes/splash.ttx";
source "scenes/title.ttx";
source "main.ttx";
