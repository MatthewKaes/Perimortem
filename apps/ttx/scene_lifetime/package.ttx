/// Tetrodotoxin
/// Copyright (c) 2023-present Matt Kaes and contributors
//
// Records exact external Package requests and member Source routes. The Package
// transaction resolves those requests before publishing any member Source.
dialect : Package;

// Keeps the package's language requirements independent from the plugins a
// particular Build chooses to satisfy them.
requires(
  .dialects = [
    package(.name = "Tetrodotoxin.Library", .version = "1.0")::Dialect,
    package(.name = "Tetrodotoxin.App", .version = "1.0")::Dialect,
    package(.name = "Tetrodotoxin.Render", .version = "1.0")::Dialect,
    package(.name = "Tetrodotoxin.Scene", .version = "1.0")::Dialect,
    package(.name = "Tetrodotoxin.Shader", .version = "1.0")::Dialect,
  ],
);

package(.name = "Tetrodotoxin.SceneLifetime", .version = "1.0");

public MainSource : alias = source("main.ttx");
