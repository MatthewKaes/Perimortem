// # Tetrodotoxin
// Copyright (c) 2023-present Matt Kaes and contributors
//
// A mock splash screen fades in, then out, two icons and then transitions
// to the next scene.
//
dialect : Scene;

private const bottom_icon : Graphics::Sprite = new;
private const fade_time   : R64 = 1.0;
private const hold_time   : R64 = 1.5;
private const top_icon    : Graphics::Sprite = new;

signal finished;
private state elapsed : R64 = 0.0;

Scene prepare[self] -> Void {
  state image := Graphics::Image -> decode(.bytes = $[resources/logo.png])!;
  self -> configure_icon(self.top_icon, image, (.x = 200.0, .y = 100.0));
  self -> configure_icon(self.bottom_icon, image, (.x = 200.0, .y = 400.0));
  self.elapsed = 0.0;
  return;
}

Scene release[self] -> Void : return;
Scene update[self, .delta_time : R64] -> Scene::Flow {
  self.elapsed = self.elapsed + delta_time;

  const duration : R64 = fade_time * 2.0 + hold_time;
  state alpha    : R64 = 0.0;
  if (self.elapsed < fade_time) : alpha = self.elapsed / fade_time;
  if (self.elapsed >= fade_time and self.elapsed < fade_time + hold_time) : alpha =
      1.0;
  if (self.elapsed >= fade_time + hold_time and self.elapsed < duration) : alpha =
      (duration - self.elapsed) / fade_time;

  self.top_icon.tone.alpha    = alpha;
  self.bottom_icon.tone.alpha = alpha;
  if (self.elapsed >= duration) : return Scene::Flow -> emit(self.finished);

  return Scene::Flow -> stay();
}

private func configure_icon[
  self,
  .icon : Graphics::Sprite,
  .image : Graphics::Image,
  .position : Graphics::Point2D,
] -> [] {
  icon.image = image;
  icon.size_pixels = image -> get_size_pixels();
  icon.transform.translation = position;
  icon.tone = (.red = 1.0, .green = 1.0, .blue = 1.0, .alpha = 0.0);
}
