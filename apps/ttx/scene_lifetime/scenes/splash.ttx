// Perimortem Engine
// Copyright © Matt Kaes
//
// A mock splash screen fades in, then out, two icons and then transitions
// to the next scene.
//
dialect : Scene;

signal finished;

state top_icon : Graphics::Sprite = new;
state bottom_icon : Graphics::Sprite = new;
state elapsed : Real_64 = 0.0;

const fade_time : Real_64 = 1.0;
const hold_time : Real_64 = 1.5;

private func create_icon[self, .image : Graphics::Image, .position : Graphics::Point2D]
    -> Graphics::Sprite {
  return (
    .image = image,
    .size_pixels = image -> get_size_pixels(),
    .position = position,
    .tone = (.r = 1.0, .g = 1.0, .b = 1.0, .a = 0.0),
  );
}

Scene prepare[self] -> Void {
  // TODO: Move this to a Library and give it global state so we only decode it once and use
  // the result across scenes rather than decoding the same embedded each transition.
  state image := Graphics::Image -> decode($[resources/logo.png]);
  self.top_icon = self -> create_icon(image, (.x = 200, .y = 100));
  self.bottom_icon = self -> create_icon(image, (.x = 200, .y = 400));
  self.elapsed = 0.0;
  return;
}

Scene update[self, .delta_time : Real_64] -> Scene::Flow {
  self.elapsed = self.elapsed + delta_time;

  const duration : Real_64 = fade_time * 2.0 + hold_time;
  state alpha : Real_64 = 0.0;

  if (self.elapsed < fade_time) {
    alpha = self.elapsed / fade_time;
  }

  if (self.elapsed >= fade_time and self.elapsed < fade_time + hold_time) {
    alpha = 1.0;
  }

  if (self.elapsed >= fade_time + hold_time and self.elapsed < duration) {
    alpha = (duration - self.elapsed) / fade_time;
  }

  self.top_icon.tone.a = alpha;
  self.bottom_icon.tone.a = alpha;

  if (self.elapsed >= duration) {
    return Scene::Flow -> emit(self.finished);
  }

  return Scene::Flow -> stay();
}

Scene release[self] -> Void {
  return;
}
