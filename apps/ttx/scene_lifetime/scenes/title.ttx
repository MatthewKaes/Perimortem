// Perimortem Engine
// Copyright © Matt Kaes
//
// A mock title screen that responds to simple inputs.
//
dialect : Scene;

signal space_pressed;
signal shift_pressed;

state title_card : Graphics::Sprite = new;

Scene prepare[self] -> Void {
  state image := Graphics::Image -> decode($[resources/logo.png]);
  self.title_card = (
    .image = image,
    .size_pixels = image -> get_size_pixels(),
    .position = (.x = 200, .y = 250),
    .tone = (.r = 1.0, .g = 1.0, .b = 1.0, .a = 1.0),
  );
  return Void;
}

Scene update[self, .delta_time : Real_64] -> Scene::Flow {
  const input := System -> get_input();

  if (input -> pressed(.key = System::Key -> space())) {
    return Scene::Flow -> emit(self.space_pressed);
  }

  if (input -> pressed(.key = System::Key -> shift())) {
    return Scene::Flow -> emit(self.shift_pressed);
  }

  return Scene::Flow -> stay();
}

Scene release[self] -> Void {
  return Void;
}
