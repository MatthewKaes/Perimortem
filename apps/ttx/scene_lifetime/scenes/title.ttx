//
// A title screen that publishes keyboard input as Scene Signals.
dialect : Scene;

using System::Key;

signal space_pressed;
signal shift_pressed;
private state title_card : Graphics::Sprite;

Scene prepare[self] -> [] {
  state image := Graphics::Format::PNG -> decode(.bytes = $[resources/icon.png] ->
      get_view())!;
  state position : Graphics::Point2D = (.x = 200.0, .y = 250.0);
  self.title_card.image       = image;
  self.title_card.size_pixels = image -> get_size_pixels();
  self.title_card.transform   = (
    .translation              = position,
    .scale_x                  = 1.0,
    .scale_y                  = 1.0,
    .rotation                 = 0.0,
  );
  self.title_card.tone        = (.red = 1.0, .green = 1.0, .blue = 1.0, .alpha =
      1.0);
}

Scene release[self] -> [] : return;
Scene update[self, .delta_time : R64] -> [] {
  state input := System::Input -> snapshot();
  if (input -> pressed(.key = space)) : emit space_pressed;
  if (input -> pressed(.key = shift)) : emit shift_pressed;
}
