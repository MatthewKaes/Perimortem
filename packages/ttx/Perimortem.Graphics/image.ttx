//
// Stable decoded pixels owned independently from backend resources.
//
dialect : Library;

foreign "C" {
  public func perimortem_graphics_image_decode[.bytes : View[U8]] -> Option[Image];
}

// Image is a decoded RGBA value whose Object buffer can be shared by immutable
// copies. Its dimensions and addressing policy give those pixels graphics
// meaning while Vulkan remains responsible for device images and uploads.
public Image : struct {
  private state pixels      : Object[Pixel];
  private state pixel_count : U64;
  private state size_pixels : Size2D;
  private state addressing  : U8;

  // Decodes one PNG and reports malformed or unsupported input as absence.
  public decode : func = [.bytes : View[U8]] -> Option[
    Image,
  ] : return foreign -> perimortem_graphics_image_decode(bytes);

  public get_pixels : func = [self] -> View[Pixel] : return self.pixels -> get_view() ->
      slice(0, self.pixel_count);
  public get_size_pixels : func = [self] -> Size2D : return self.size_pixels;
}
