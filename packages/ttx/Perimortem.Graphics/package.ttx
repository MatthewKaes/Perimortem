/// Tetrodotoxin
/// Copyright (c) 2023-present Matt Kaes and contributors
//
// Publishes the value, resource, and hosted Object Types used by graphics.
//
dialect : Package;

resolve Math : Perimortem.Math = "1.0";
source Pixel from "pixel.ttx";
source Point2D from "point2d.ttx";
source Size2D from "size2d.ttx";
source Tone from "tone.ttx";
source Transform2D from "transform2d.ttx";
source Placement2D from "placement2d.ttx";
source Image from "image.ttx";
source Texture2D from "texture2d.ttx";
source Format::PNG from "png.ttx";
source Sprite from "sprite.ttx";
source Render from "render.ttx";
source Shader from "shader.ttx";
