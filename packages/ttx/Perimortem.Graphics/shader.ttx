// # Tetrodotoxin
// Copyright (c) 2023-present Matt Kaes and contributors
//
// Sprite rendering expressed through shared Library execution meaning.
//
dialect : Shader;

public SpriteProgram : shader Render::Sprite {
  @set(0) @slot(0) @read
  public image : resource Image::Image;
  public sprite : push ShaderTypes::SpriteInputs;

  public fragment : func = [@location(0).texture_uv : Math::Vec2D] -> [
    @location(0).color : Math::Vec4D,
  ] {
    state sampled := image -> sample(.uv = texture_uv);
    state color   : Math::Vec4D = (
      .x = sampled.x * sprite.tone.x,
      .y = sampled.y * sprite.tone.y,
      .z = sampled.z * sprite.tone.z,
      .w = sampled.w * sprite.tone.w,
    );
    return (.color = color);
  }

  public vertex : func = [
    @location(0).position : Math::Vec2D,
    @location(1).texture_uv : Math::Vec2D,
  ] -> [@builtin("position").clip_position : Math::Vec4D, @location(0).texture_uv : Math::Vec2D] {
    state one := sprite.transform_x.w / sprite.transform_x.w;
    state two := one + one;
    state zero := one - one;
    state pixel : Math::Vec2D = (
      .x = sprite.transform_x.x * position.x + sprite.transform_x.y * position.y +
          sprite.transform_x.z,
      .y = sprite.transform_y.x * position.x + sprite.transform_y.y * position.y +
          sprite.transform_y.z,
    );
    state clip : Math::Vec2D = (
      .x = pixel.x / sprite.transform_x.w * two - one,
      .y = one - pixel.y / sprite.transform_y.w * two,
    );
    state clip_position : Math::Vec4D = (.x = clip.x, .y = clip.y, .z = zero, .w =
        one);
    state sampled_uv : Math::Vec2D = (.x = texture_uv.x, .y = one - texture_uv.y);
    return (.clip_position = clip_position, .texture_uv = sampled_uv);
  }
}
