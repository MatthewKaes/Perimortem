//
// Value layouts shared by the Sprite Shader and its host renderer.
//
dialect : Library;

// SpriteInputs is the push layout consumed by both graphics Stages. Vulkan
// derives its byte range from these three ordered vector values.
public SpriteInputs : struct {
  public state transform_x : Math::Vec4D;
  public state transform_y : Math::Vec4D;
  public state tone        : Math::Vec4D;
}
