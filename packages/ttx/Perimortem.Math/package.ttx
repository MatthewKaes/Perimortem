dialect : Package;

public Vec2DSource : alias = source("vec2d.ttx");
public Vec3DSource : alias = source("vec3d.ttx");
public Vec4DSource : alias = source("vec4d.ttx");

public Vec2D : alias = Vec2DSource::Vec2D;
public Vec3D : alias = Vec3DSource::Vec3D;
public Vec4D : alias = Vec4DSource::Vec4D;
