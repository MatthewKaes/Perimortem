// Perimortem System Package.
dialect : Package;

public TerminalSource : alias = source("terminal.ttx");
public KeySource      : alias = source("key.ttx");
public InputSource    : alias = source("input.ttx");

public Terminal : alias = TerminalSource::Terminal;
public Key      : alias = KeySource::Key;
public Input    : alias = InputSource::Input;
