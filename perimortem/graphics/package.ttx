// Perimortem Engine
// Copyright © Matt Kaes
dialect : Package;

import Types : Library = "library/types.ttx";
import Sprite : Library = "library/sprite.ttx";
import Render2D : Render = "renderers/renderer_2d.ttx";
import Default2D : Shader = "shaders/default_2d.ttx";

@package_name = Perimortem::Graphics;

expose Color : alias = Types::Color;
expose Sampler2D : alias = Types::Sampler2D;
expose Sprite : alias = Sprite::Sprite;

expose Renderer : Namespace {
  expose Renderer2D : alias = Render2D::Renderer2D;
}

expose Shaders : Namespace {
  expose Default2D : alias = Default2D;
}
