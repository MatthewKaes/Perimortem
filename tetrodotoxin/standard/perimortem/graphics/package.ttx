// Perimortem Engine
// Copyright © Matt Kaes
dialect : Package;

resolve Math : Perimortem.Math = "1.0";

source Types : Library = "library/types.ttx";
source Renderer2D : Render = "renderers/renderer_2d.ttx";
source Default2D : Shader = "shaders/default_2d.ttx";

public Color : alias = Types::Color;
public Image : alias = Types::Image;
public Point2D : alias = Types::Point2D;
public Render2D : alias = Renderer2D::Render2D;
public Size2D : alias = Math::Geometry::Size2D;
public Shaders : group {
  public Default2D : alias = Default2D;
}
