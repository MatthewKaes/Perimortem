dialect : Library;

// A window is owned by the application runtime because its lifetime, input,
// and event processing are operating-system concerns. Render backends consume
// its native presentation information at the runtime composition boundary.
// Graphics does not own or manufacture windows.
public Window : object {
  public func create[
    .title : View[Bytes],
    .width : Unsigned_32,
    .height : Unsigned_32,
  ] -> Window;
}

// Time matches Perimortem::Core::Time as a value timestamp measured in
// nanoseconds. The conversion functions keep unit changes explicit at the
// public boundary while Frame can copy each timestamp without managed object
// identity or allocation.
public Time : struct {
  private timestamp : Unsigned_64 = 0;

  public func from_seconds[.value : Real_64] -> Time;

  public func get_seconds[self] -> Real_64;
}

public Frame : struct {
  public scene_time : Time;
  public frame_time : Time;
  public delta_time : Time;
}
