dialect : Library;

// A window is owned by the application runtime because its lifetime, input,
// and event processing are operating-system concerns. Render backends consume
// its native presentation information at the runtime composition boundary.
// Graphics does not own or manufacture windows.
public Window : object {
  public func create[
    .title : View[Bytes],
    .width : Bits_32,
    .height : Bits_32,
  ] -> Window;
}

public Time : object {
  public seconds : Real_64 = 0.0;

  public func from_seconds[.value : Real_64] -> Time;

  public func get_seconds[] -> Real_64;
}

public Frame : struct {
  public scene_time : Time;
  public frame_time : Time;
  public delta_time : Time;
}
