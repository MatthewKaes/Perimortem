dialect : Library;

// Packet is the broad fixture's inline value owner.
//
// The empty documentation line above must survive as a paragraph break.
@serializable
@revision(1)
@priority(-1)
@ratio(1.5)
@enabled(true)
@label("packet")
public Packet : struct {
  public width : Unsigned_64 = 0;
  public height : Unsigned_64 = 0;
  public ready : Bool = false;

  public func identity[.value : Unsigned_64] -> Unsigned_64 {
    return value;
  }

  public func identity[self] -> Unsigned_64 {
    return Packet -> finish(self.width + self.height);
  }

  private checksum : Unsigned_64 = 0;

  private func finish[.value : Unsigned_64] -> Unsigned_64 {
    return value;
  }
}

public Mode : enum[Unsigned_8] {
  idle = 0;
  active = 1;
  paused = 0x2;
}

public Session : object {
  expose state progress : Unsigned_64 = 0;

  public func advance[self, .amount : Unsigned_64] -> Unsigned_64 {
    self.progress += amount;
    return self.progress;
  }

  private state token : Unsigned_64 = 7;

  private func token_value[self] -> Unsigned_64 {
    return self.token;
  }
}

public PacketAlias : alias = Packet;
expose state observed_total : Unsigned_64 = 0;
public const signature : Fixed[Unsigned_8, 4] = 0x[54 54 58 31];
public default_packet : PacketAlias = (
  .width = 2,
  .height = 3,
  .ready = true,
);
public dense_defaults : Fixed[Unsigned_64, 4] = (1, 2, 3, 4);

public func broad_entry[
  @input @slot(0) .limit : Unsigned_64,
  @input @slot(1) .ready : Bool,
] -> Unsigned_64 {
  state local : Unsigned_64 = 0;
  state packet : Packet = default_packet;
  state dense : Fixed[Unsigned_64, 4] = (1, 2, 3, 4);
  state sparse : Fixed[Unsigned_64, 4] = (
    .0 = 8,
    .0x1 = 13,
    .2 = 21,
    .0x3 = 34,
  );
  state middle : Fixed[Unsigned_64, 2] = dense:[1, 2];
  state dimensions : Fixed[Unsigned_64, 2] = packet.[width, height];
  state negative : Signed_64 = -1;
  state accepted : Bool = ready and limit > 0;
  state session : Session = new;

  if (accepted) {
    local = Packet -> identity(limit);
  }

  while (local < limit) {
    local += 1;
    if (local == 2) {
      continue;
    }
    if (!ready or local >= limit) {
      break;
    }
  }

  for [.index : Unsigned_64] in 0...limit {
    local += index;
  }

  match local % 3 {
    case 0: {
      local += 3;
    }
    case 1: {
      local -= 1;
    }
    case _: {
      local = local * 2 / 1;
    }
  }

  packet.width = local;
  local = packet -> identity();
  session -> advance(middle:[0]);
  foreign -> library_observe(dimensions:[0]);
  private_total = PrivateOps -> combine(local, sparse:[0]);
  observed_total = private_total;
  return observed_total;
}

public func reset[] -> Void {
  observed_total = 0;
  return;
}

public func unnamed_layout[Unsigned_64, Bool] -> [Unsigned_64, Bool] {
  return (0, false);
}

public func classify[.value : Unsigned_64] -> [
  .accepted : Bool,
  .adjusted : Unsigned_64,
] {
  return (.adjusted = value + 1, .accepted = value > 0);
}

foreign "C" {
  public func library_observe[.value : Unsigned_64] -> [];
}

private PrivateOps : struct {
  public func combine[
    .left : Unsigned_64,
    .right : Unsigned_64,
  ] -> Unsigned_64 {
    return left + right;
  }
}

private state private_total : Unsigned_64 = 0;
private const mask : Unsigned_64 = 0xFF;
private decode_table : Fixed[Unsigned_8, 4] = (
  .0 = 0,
  .1 = 1,
  .2 = 2,
  .3 = 3,
);
private private_packet : Packet = (
  .width = 5,
  .height = 8,
  .ready = false,
);
