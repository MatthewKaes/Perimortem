//
dialect : Library;

foreign "C" {
  public func library_observe[.value : Unsigned_64] -> [];
}

public PacketAlias : alias = Packet;

private const mask     : Unsigned_64 = 0xFF;
public const signature : Fixed[Unsigned_8, 4] = 0x[54 54 58 31];

public observed_total  : Unsigned_64 = 0;
public default_packet  : PacketAlias = (.width = 2, .height = 3, .ready = true);
public dense_defaults  : Fixed[Unsigned_64, 4] = (1, 2, 3, 4);
private private_total  : Unsigned_64 = 0;
private private_packet : Packet = (.width = 5, .height = 8, .ready = false);

public broad_entry : func = [.limit : Unsigned_64, .ready : Bool] -> Unsigned_64 {
  state local      : Unsigned_64 = 0;
  state packet     : Packet = default_packet;
  state dense      : Fixed[Unsigned_64, 4] = (1, 2, 3, 4);
  state middle     : Fixed[Unsigned_64, 2] = dense:[1, 2];
  state dimensions : Fixed[Unsigned_64, 2] = packet.[width, height];
  state negative   : Signed_64 = -1;
  state accepted   : Bool = ready and limit > 0;
  state session    : Session = new[Session];
  if (accepted) : local = Packet -> identity(limit);
  while (local < limit) {
    local += 1;
    if (local == 2) : continue;
    if (!ready or local >= limit) : break;
  }

  for [.index : Unsigned_64] in 0...limit : local += index;
  match local % 3 {
    case 0 : local += 3;
    case 1 : local -= 1;
    case _ : local = local * 2 / 1;
  }

  packet.width = local;
  local        = packet -> identity();
  session -> advance(middle:[0]);
  foreign -> library_observe(dimensions:[0]);
  private_total  = PrivateOps -> combine(local, dense:[0]);
  observed_total = private_total;
  return observed_total;
}

public classify : func = [.value : Unsigned_64] -> [
  .accepted : Bool,
  .adjusted : Unsigned_64,
] : return (.adjusted = value + 1, .accepted = value > 0);
public positional_result : func = [.value : Unsigned_64, .flag : Bool] -> [
  Unsigned_64,
  Bool,
] : return (0, false);
public reset : func = [] -> [] : observed_total = 0;

public Mode : enum[Unsigned_8] {
  active = 1;
  idle = 0;
  paused = 0x02;
}

// Packet is the broad fixture's inline value owner.
//
// The empty documentation line above must survive as a paragraph break.
public Packet : struct {
  public state width  : Unsigned_64 = 0;
  public state height : Unsigned_64 = 0;
  public state ready  : Bool        = false;
  private checksum    : Unsigned_64 = 0;

  public identity : func = [.value : Unsigned_64] -> Unsigned_64 : return value;

  public identity : func = [self] -> Unsigned_64 : return Packet -> finish(self.width +
      self.height);

  private finish : func = [.value : Unsigned_64] -> Unsigned_64 : return value;
}

public Session : object {
  expose state progress : Unsigned_64 = 0;
  private state token   : Unsigned_64 = 7;

  public advance : func = [self, .amount : Unsigned_64] -> Unsigned_64 {
    self.progress += amount;
    return self.progress;
  }

  private token_value : func = [self] -> Unsigned_64 : return self.token;
}

private PrivateOps : struct {
  public combine : func = [
    .left : Unsigned_64,
    .right : Unsigned_64,
  ] -> Unsigned_64 : return left + right;
}
