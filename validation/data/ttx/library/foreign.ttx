// Foreign access and invocation acceptance.
dialect : Library;

// Stable C interoperability entry with repeated TTX-owned Static state.
@abi("C")
@symbol("library_native")
public library_native : func = [] -> Unsigned_64 {
  total += PrivateOps -> increment();
  foreign.library_foreign_state = total;
  return foreign -> library_foreign_add(
    foreign.library_foreign_state,
    foreign.library_foreign_bias
  );
}

private total : Unsigned_64 = 0;

private PrivateOps : struct {
  public increment : func = [] -> Unsigned_64 {
    return 20;
  }
}

// This local carrier deliberately has a distinct semantic identity from the
// provider's Large Type. The shared C boundary, rather than one LLVM module,
// must agree on its physical System V aggregate representation.
private CrossArtifactLarge : struct {
  public state first : Unsigned_64 = 0;
  public state second : Unsigned_64 = 0;
  public state third : Unsigned_64 = 0;
}

@abi("C")
@symbol("library_cross_artifact")
public cross_artifact : func = [] -> Unsigned_64 {
  state value : CrossArtifactLarge = (
    .first = 4,
    .second = 5,
    .third = 6,
  );
  return foreign -> llvm_large_sum(value);
}

foreign "C" {
  expose state library_foreign_bias : Unsigned_64;
  public state library_foreign_state : Unsigned_64;
  public func library_foreign_add[
    .left : Unsigned_64,
    .right : Unsigned_64,
  ] -> Unsigned_64;
  public func llvm_large_sum[.value : CrossArtifactLarge] -> Unsigned_64;
}
