//
dialect : Library;

foreign "C" {
  public const imported_constant : Unsigned_64;
  public state imported_state : Unsigned_64;
  public func imported_function[
    .left : Unsigned_64,
    .right : Unsigned_64,
  ] -> Unsigned_64;
}

public consume_imports : func = [] -> Unsigned_64 {
  foreign.imported_state = foreign.imported_constant;
  return foreign -> imported_function(
    foreign.imported_state,
    foreign.imported_constant
  );
}
