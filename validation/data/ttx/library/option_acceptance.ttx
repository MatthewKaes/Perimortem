// Library Option acceptance.
dialect : Library;

public Maybe : alias = Option[Unsigned_64];

public Session : object {
  private state count : Unsigned_64;
}

private const absent : Maybe = ();
private const present : Maybe = 7;
private const defaulted := absent!;
private const selected := present!;

private const absent_session : Option[Session] = ();
private first_session : Session = absent_session!;
private second_session : Session = absent_session!;

public propagate : func = [.value : Maybe] -> Maybe {
  return value?;
}

public stop : func = [.value : Maybe] -> [] {
  state selected := value?;
  return;
}

public choose : func = [.value : Maybe] -> Unsigned_64 {
  match value {
    case selected : { return selected; }
    case _ : { return 0; }
  }
}
