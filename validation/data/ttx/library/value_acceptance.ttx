// Library value acceptance.
dialect : Library;

public Packet : struct {
  public state width : Unsigned_64 = 2;
  public state height : Unsigned_64 = 3;

  public total : func = [self] -> Unsigned_64 {
    return self.width + self.height;
  }
}

public Pair : struct {
  public state first : Unsigned_64;
  public state second : Unsigned_64;
}

public const slice_offset : Unsigned_64 = 1;

public SliceParameters : struct {
  public const offset : Unsigned_64 = 1;
  public const size : Unsigned_64 = 2;
}

public Factory : struct {
  public identity : func = [.value : Packet] -> Packet {
    return value;
  }

  public add : func = [
    .left : Unsigned_64,
    .right : Unsigned_64,
  ] -> Unsigned_64 {
    return left + right;
  }
}

private folded_add : func = [] -> Unsigned_64 {
  return 2 + 3;
}

private default_byte : func = [] -> Unsigned_8 {
  return 0x[10 20 30]:[99];
}

private packet : Packet;
private sum := 2 + 3;
private constant_offset := source.slice_offset + 12;
private sequence := 1...4;
private selected_byte := 0x[10 20 30]:[1];
private missing_byte := 0x[10 20 30]:[99];
private selected_slice : Fixed[Unsigned_8, 2] = 0x[10 20 30]:[1, 2];
private missing_slice : Fixed[Unsigned_8, 2] = 0x[10 20 30]:[99, 2];
private constant_slice : Fixed[Unsigned_8, 2] =
  0x[00 01 02 03 04 05 06 07 08 09 0A 0B 0C 0D 0E 0F]:[
    SliceParameters.offset + 12,
    SliceParameters.size
  ];
private called := Factory -> add(2, 3);
private addressed := packet.width;
private self_called := packet -> total();
private empty : func = [] -> [] {
  return packet.[];
}
private single : Unsigned_64 = packet.[width];
private reordered : Pair = packet.[height, width];
