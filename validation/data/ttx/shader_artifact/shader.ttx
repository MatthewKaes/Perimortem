dialect : Shader;

public TestShader : shader Formats::Simple {
  public fragment : func = [@location(0).color : Math::Vec4D] -> [@location(0).color : Math::Vec4D] {
    state copied : Math::Vec4D = (
      .x = color.x + color.y,
      .y = color.y + color.z,
      .z = color.z + color.w,
      .w = color.w + color.x,
    );
    return (.color = copied);
  }
}
