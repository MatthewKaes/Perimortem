dialect : Library;

// Allow direct calling of C symbols.
foreign "C" {
  public func ttx_test_add[.left : Unsigned_64, .right : Unsigned_64] -> [.result : Unsigned_64];
  public func ttx_test_sum7[
    .a : Unsigned_64,
    .b : Unsigned_64,
    .c : Unsigned_64,
    .d : Unsigned_64,
    .e : Unsigned_64,
    .f : Unsigned_64,
    .g : Unsigned_64
  ] -> Unsigned_64;
  public func ttx_test_real9[
    .a : Real_64,
    .b : Real_64,
    .c : Real_64,
    .d : Real_64,
    .e : Real_64,
    .f : Real_64,
    .g : Real_64,
    .h : Real_64,
    .i : Real_64
  ] -> Real_64;
}

public AddCounter : struct {
  public value : Unsigned_64 = 0;
  public add : Unsigned_64 = 0;

  public func identity[.value : Unsigned_64] -> Unsigned_64 {
    return value;
  }

  public func identity[self] -> Unsigned_64 {
    return self.value + self.add;
  }
}

public func tetrodotoxin_test[.data : View[Unsigned_8]] -> [] {
  foreign -> print("Compiler Test");
  foreign -> print(data);
}

public func arithmetic[.value : Unsigned_64] -> [.result : Unsigned_64] {
  return foreign -> ttx_test_add(value, 5) * 2;
}

public func sum7[
  .a : Unsigned_64,
  .b : Unsigned_64,
  .c : Unsigned_64,
  .d : Unsigned_64,
  .e : Unsigned_64,
  .f : Unsigned_64,
  .g : Unsigned_64
] -> [.result : Unsigned_64] {
  return a + b + c + d + e + f + g;
}

public func call_sum7[
  .a : Unsigned_64,
  .b : Unsigned_64,
  .c : Unsigned_64,
  .d : Unsigned_64,
  .e : Unsigned_64,
  .f : Unsigned_64,
  .g : Unsigned_64
] -> Unsigned_64 {
  return foreign -> ttx_test_sum7(a, b, c, d, e, f, g);
}

public func call_real9[
  .a : Real_64,
  .b : Real_64,
  .c : Real_64,
  .d : Real_64,
  .e : Real_64,
  .f : Real_64,
  .g : Real_64,
  .h : Real_64,
  .i : Real_64
] -> Real_64 {
  return foreign -> ttx_test_real9(a, b, c, d, e, f, g, h, i);
}

public func is_even[.value : Unsigned_64] -> Bool {
  return value % 2 == 0;
}

public func bool_identity[.value : Bool] -> Bool {
  return value;
}

public func negative[] -> Signed_64 {
  return -42;
}

public func signed_half[.value : Signed_64] -> Signed_64 {
  return value / 2;
}

public func real_constant[] -> Real_64 {
  return 4.25;
}

public func constant_math[] -> Unsigned_64 {
  return 2 + 3;
}

public func byte_array[] -> View[Unsigned_8] {
  return 0x[AA FF 12 45 ACDE];
}

public func text_literal[] -> View[Unsigned_8] {
  return "Raw string";
}

public func source_file[] -> View[Unsigned_8] {
  return $[source.ttx];
}

public func swap[.first : Unsigned_64, .second : Unsigned_64] -> [.first : Unsigned_64, .second : Unsigned_64] {
  return (.second = first, .first = second);
}

public func type_call[.value : Unsigned_64] -> Unsigned_64 {
  return AddCounter -> identity(value);
}

public func addressable_call[.value : Unsigned_64er] -> Unsigned_64er {
  return value -> identity();
}
