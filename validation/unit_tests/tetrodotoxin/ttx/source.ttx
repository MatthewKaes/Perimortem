dialect : Library;

private Console : foreign {
  expose func print[.data : View[Bytes]] -> [];
}

private Math : foreign {
  expose func ttx_test_add[.left : Count, .right : Count] -> [.result : Count];
  expose func ttx_test_sum7[
    .a : Count,
    .b : Count,
    .c : Count,
    .d : Count,
    .e : Count,
    .f : Count,
    .g : Count
  ] -> Count;
  expose func ttx_test_real9[
    .a : Real_64,
    .b : Real_64,
    .c : Real_64,
    .d : Real_64,
    .e : Real_64,
    .f : Real_64,
    .g : Real_64,
    .h : Real_64,
    .i : Real_64
  ] -> Real_64;
}

public func tetrodotoxin_test[.data : View[Bytes]] -> [] {
  Console -> print("Compiler Test");
  Console -> print(data);
}

public func arithmetic[.value : Count] -> [.result : Count] {
  return Math -> ttx_test_add(value, 5) * 2;
}

public func sum7[
  .a : Count,
  .b : Count,
  .c : Count,
  .d : Count,
  .e : Count,
  .f : Count,
  .g : Count
] -> [.result : Count] {
  return a + b + c + d + e + f + g;
}

public func call_sum7[
  .a : Count,
  .b : Count,
  .c : Count,
  .d : Count,
  .e : Count,
  .f : Count,
  .g : Count
] -> Count {
  return Math -> ttx_test_sum7(a, b, c, d, e, f, g);
}

public func call_real9[
  .a : Real_64,
  .b : Real_64,
  .c : Real_64,
  .d : Real_64,
  .e : Real_64,
  .f : Real_64,
  .g : Real_64,
  .h : Real_64,
  .i : Real_64
] -> Real_64 {
  return Math->ttx_test_real9(a, b, c, d, e, f, g, h, i);
}

public func is_even[.value : Count] -> Bool {
  return value % 2 == 0;
}

public func negative[] -> Signed_64 {
  return -42;
}

public func signed_half[.value : Signed_64] -> Signed_64 {
  return value / 2;
}

public func real_constant[] -> Real_64 {
  return 4.25;
}

public func constant_math[] -> Count {
  return 2 + 3;
}

public func byte_array[] -> View[Bytes] {
  return 0x[AA FF 12 45 ACDE];
}

public func text_literal[] -> View[Bytes] {
  return "Raw string";
}

public func source_file[] -> View[Bytes] {
  return $[source.ttx];
}

public func swap[.first : Count, .second : Count] -> [.first : Count, .second : Count] {
  return (.second = first, .first = second);
}
